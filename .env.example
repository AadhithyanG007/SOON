# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env.local for local development
# NEVER commit .env.local or any file with actual secrets
#
# SECURITY NOTES:
# - Variables prefixed with VITE_ are exposed to the browser (PUBLIC)
# - Do NOT put sensitive secrets in VITE_ variables
# - Sensitive keys should only exist on your backend/server
# ============================================================================

# Example: Public analytics ID (safe for frontend)
# VITE_PUBLIC_ANALYTICS_ID=your-analytics-id-here

# Example: Public API endpoint (safe for frontend)
# VITE_PUBLIC_API_URL=https://api.example.com

# ============================================================================
# SECRETS THAT SHOULD NEVER BE IN FRONTEND CODE
# ============================================================================
# These should ONLY exist in your backend, serverless functions, or hosting
# environment - NEVER in client-side code:
#
# - API keys with write permissions
# - Database connection strings
# - JWT signing secrets
# - Payment processor keys (Stripe secret key, etc.)
# - OAuth client secrets
# - Encryption keys
#
# If you need these, create a backend API or use serverless functions
# ============================================================================
