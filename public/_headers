# ============================================================================

# SECURITY HEADERS FOR CLOUDFLARE PAGES DEPLOYMENT (OWASP Best Practices)

# ============================================================================

# This file configures security headers optimized for Cloudflare Pages.

# These headers provide defense-in-depth against common web attacks.

# ============================================================================

/\*

# ==========================================================================

# CORE SECURITY HEADERS

# ==========================================================================

# SECURITY: Prevents MIME-sniffing attacks

# Browsers should trust the Content-Type header and not try to detect the type

X-Content-Type-Options: nosniff

# SECURITY: Prevents clickjacking attacks

# Disallows embedding this site in iframes on other domains

X-Frame-Options: DENY

# SECURITY: Controls referrer information leakage

# Only sends origin (not full URL) to cross-origin requests

Referrer-Policy: strict-origin-when-cross-origin

# SECURITY: Restricts browser features for privacy/security

# Disables access to sensitive device features

Permissions-Policy: accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=()

# SECURITY: Prevents cross-origin window attacks

Cross-Origin-Opener-Policy: same-origin

# SECURITY: Prevents cross-origin resource sharing attacks

Cross-Origin-Resource-Policy: same-origin

# SECURITY: Enables cross-origin isolation for enhanced security

Cross-Origin-Embedder-Policy: credentialless

# SECURITY: Forces HTTPS connections (Cloudflare handles SSL, but this adds extra layer)

# max-age=31536000 = 1 year, includeSubDomains for all subdomains, preload for HSTS preload list

Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# SECURITY: Legacy XSS protection (modern browsers use CSP, but this helps older browsers)

X-XSS-Protection: 1; mode=block

# SECURITY: Prevents DNS prefetching to avoid information leakage

X-DNS-Prefetch-Control: off

# SECURITY: Disables client-side caching for sensitive pages (adjust as needed for static assets)

Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
Pragma: no-cache

# SECURITY: Content Security Policy (CSP)

# Comprehensive policy restricting resource loading to trusted sources

Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; block-all-mixed-content

# SECURITY: Expect-CT header for Certificate Transparency monitoring

# Helps detect misissued certificates

Expect-CT: max-age=86400, enforce

# SECURITY: Prevent Adobe cross-domain policy loading

X-Permitted-Cross-Domain-Policies: none

# SECURITY: Prevent download/execution of potentially dangerous content

X-Download-Options: noopen

# ==========================================================================

# STATIC ASSETS - Enable caching for performance while maintaining security

# ==========================================================================

/\*.js
Cache-Control: public, max-age=31536000, immutable
X-Content-Type-Options: nosniff

/\*.css
Cache-Control: public, max-age=31536000, immutable
X-Content-Type-Options: nosniff

/_.woff2
Cache-Control: public, max-age=31536000, immutable
Access-Control-Allow-Origin: _

/_.woff
Cache-Control: public, max-age=31536000, immutable
Access-Control-Allow-Origin: _

/_.ttf
Cache-Control: public, max-age=31536000, immutable
Access-Control-Allow-Origin: _

/\*.png
Cache-Control: public, max-age=31536000, immutable

/\*.jpg
Cache-Control: public, max-age=31536000, immutable

/\*.jpeg
Cache-Control: public, max-age=31536000, immutable

/\*.gif
Cache-Control: public, max-age=31536000, immutable

/\*.svg
Cache-Control: public, max-age=31536000, immutable
Content-Type: image/svg+xml

/\*.webp
Cache-Control: public, max-age=31536000, immutable

/\*.ico
Cache-Control: public, max-age=31536000, immutable

# ==========================================================================

# HTML PAGES - No caching to ensure latest security updates

# ==========================================================================

/\*.html
Cache-Control: no-cache, no-store, must-revalidate
Pragma: no-cache
Expires: 0

/index.html
Cache-Control: no-cache, no-store, must-revalidate
Pragma: no-cache
Expires: 0

